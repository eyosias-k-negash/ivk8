# Copy to .env (gitignored). scripts/create-secrets.sh turns it into a k8s Secret.
# Never commit real values.

# Google OAuth client (Web application). Authorized redirect URI must match OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random bytes, hex. Generate: openssl rand -hex 32
SESSION_SECRET=

# Public URL of the app as the browser sees it (k3d local default below)
PUBLIC_BASE_URL=http://localhost:8080
