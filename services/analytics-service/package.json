{
  "name": "@ivy/analytics-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless, in-memory analytics over Ivy Wallet backups (cluster-internal API)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@ivy/contracts": "*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
